---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getPlayers, getScoreboard } from '../lib/sports/aggregate';
import { DISPLAY_TEAMS, TEAM_LOGOS } from '../data/sports-config';

const [scoreboard, players] = await Promise.all([getScoreboard(), getPlayers()]);

const initialData = { scoreboard, players };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Sports | ${SITE_TITLE}`} description="Ron's teams and players, live." />
		<style is:global>
			body {
				background: #f4f6fb;
				background-size: unset;
			}
			body > main {
				padding-top: 0;
			}

			.page-header {
				background: #1a2744;
				color: white;
				text-align: center;
				padding: 3em 1em 2.5em;
				width: 100vw;
				position: relative;
				left: 50%;
				transform: translateX(-50%);
				margin-bottom: 2em;
			}
			.page-header h1 {
				font-size: 2.441em;
				margin-bottom: 0.2em;
				color: white;
			}
			.page-header p {
				color: #a8b8d8;
				margin: 0;
				font-style: italic;
			}
			.team-logos {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 1.5em;
				margin-top: 1.5em;
			}
			.team-logos img {
				height: 48px;
				width: 48px;
				object-fit: contain;
				filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
			}
			@media (max-width: 720px) {
				.team-logos img {
					height: 36px;
					width: 36px;
				}
			}

			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-bottom: 2em;
			}
			.filter-pill {
				border: 1px solid rgb(var(--gray-light));
				background: white;
				color: rgb(var(--gray-dark));
				border-radius: 999px;
				padding: 0.4em 1em;
				font-size: 0.85em;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.filter-pill.active {
				background: #1a2744;
				border-color: #1a2744;
				color: white;
			}

			section.block {
				margin-bottom: 2.75em;
			}
			.section-title {
				font-size: 1.1em;
				font-weight: 700;
				margin-bottom: 0.9em;
				color: rgb(var(--black));
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}

			#live-block {
				display: none;
			}
			.live-banner {
				background: #1a2744;
				border: 2px solid #f0c060;
				border-radius: 12px;
				padding: 1.25em 1.5em;
				color: white;
				margin-bottom: 0.9em;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.75em;
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}
			a.live-banner:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
			}
			.live-dot {
				display: inline-block;
				width: 0.6em;
				height: 0.6em;
				border-radius: 50%;
				background: #f0c060;
				margin-right: 0.5em;
				animation: pulse 1.4s infinite;
			}
			@keyframes pulse {
				0% {
					opacity: 1;
				}
				50% {
					opacity: 0.3;
				}
				100% {
					opacity: 1;
				}
			}
			.live-label {
				font-size: 0.75em;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: #f0c060;
				font-weight: 700;
			}
			.live-matchup {
				font-size: 1.15em;
				font-weight: 700;
				margin-top: 0.2em;
			}
			.live-score {
				font-size: 1.6em;
				font-weight: 700;
				color: #f0c060;
			}
			.live-detail {
				font-size: 0.85em;
				color: #c8d4e8;
			}

			.date-group {
				margin-bottom: 1.75em;
			}
			.date-group:last-child {
				margin-bottom: 0;
			}
			.date-heading {
				font-size: 0.9em;
				font-weight: 700;
				color: #1a2744;
				margin: 0 0 0.75em;
				padding-bottom: 0.4em;
				border-bottom: 2px solid rgb(var(--gray-light));
			}

			.cards-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.25em;
			}
			.game-card,
			.player-card {
				background: white;
				border-radius: 10px;
				box-shadow: var(--box-shadow);
				padding: 1.1em 1.25em;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid #1a2744;
			}
			a.game-card {
				display: block;
				text-decoration: none;
				color: inherit;
				transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
			}
			a.game-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 26px rgba(var(--gray), 40%);
				border-left-color: #f0c060;
			}
			.league-badge {
				display: inline-block;
				font-size: 0.7em;
				font-weight: 700;
				letter-spacing: 0.06em;
				color: #1a2744;
				background: rgb(var(--gray-light));
				border-radius: 4px;
				padding: 0.15em 0.5em;
				margin-bottom: 0.6em;
			}
			.national-badge {
				display: inline-block;
				font-size: 0.7em;
				color: var(--accent);
				margin-left: 0.4em;
			}
			.matchup {
				font-weight: 700;
				font-size: 1.02em;
				color: rgb(var(--black));
				margin-bottom: 0.3em;
			}
			.game-meta {
				font-size: 0.82em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.game-score {
				font-size: 1.3em;
				font-weight: 700;
				margin-top: 0.4em;
				color: rgb(var(--black));
			}
			.status-final {
				color: rgb(var(--gray));
				font-size: 0.8em;
				font-weight: 700;
				text-transform: uppercase;
			}

			.player-name {
				font-weight: 700;
				font-size: 1.02em;
				color: rgb(var(--black));
			}
			.player-team {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-bottom: 0.7em;
			}
			.player-stats {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.stat-chip {
				background: #f4f6fb;
				border-radius: 6px;
				padding: 0.35em 0.6em;
				text-align: center;
				min-width: 3.2em;
			}
			.stat-chip .stat-value {
				display: block;
				font-weight: 700;
				color: #1a2744;
				font-size: 0.95em;
			}
			.stat-chip .stat-label {
				display: block;
				font-size: 0.65em;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.empty-state {
				color: rgb(var(--gray));
				font-size: 0.9em;
				padding: 1.5em;
				border: 2px dashed rgb(var(--gray-light));
				border-radius: 8px;
				text-align: center;
			}

			@media (max-width: 720px) {
				.page-header h1 {
					font-size: 1.953em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Sports</h1>
				<p>Games and players I follow — updated live.</p>
				<div class="team-logos">
					{
						DISPLAY_TEAMS.map((t) => (
							<img src={TEAM_LOGOS[t]} alt={t} title={t} loading="lazy" />
						))
					}
				</div>
			</div>

			<div class="filters" id="team-filters">
				<button class="filter-pill active" data-team="all">All</button>
				{
					DISPLAY_TEAMS.map((t) => (
						<button class="filter-pill active" data-team={t}>
							{t}
						</button>
					))
				}
			</div>

			<section class="block" id="live-block">
				<p class="section-title">Live Now</p>
				<div id="live-container"></div>
			</section>

			<section class="block">
				<p class="section-title">Upcoming Games</p>
				<div id="upcoming-container"></div>
			</section>

			<section class="block">
				<p class="section-title">Recent Results</p>
				<div id="recent-container"></div>
			</section>

			<section class="block">
				<p class="section-title">Favorite Players</p>
				<div id="players-container" class="cards-grid"></div>
			</section>
		</main>
		<Footer />

		<script type="application/json" id="sports-initial-data" is:inline set:html={JSON.stringify(initialData)} />

		<script>
			interface GameInfo {
				id: string;
				league: string;
				team: string;
				opponent: string;
				isHome: boolean;
				startTimeUTC: string;
				venue?: string;
				broadcast?: string;
				isNationalTV: boolean;
				link?: string;
				status: 'scheduled' | 'live' | 'final' | 'postponed' | 'unknown';
				statusDetail?: string;
				teamScore?: number;
				opponentScore?: number;
			}
			interface PlayerStatLine {
				label: string;
				value: string;
			}
			interface PlayerInfo {
				name: string;
				team: string;
				league: string;
				position?: string;
				stats: PlayerStatLine[];
				updatedAt: string;
			}
			interface Scoreboard {
				upcoming: GameInfo[];
				recent: GameInfo[];
				live: GameInfo[];
				hasLive: boolean;
				generatedAt: string;
			}
			interface PlayersPayload {
				players: PlayerInfo[];
				generatedAt: string;
			}

			const LIVE_POLL_MS = 40_000;
			const IDLE_POLL_MS = 10 * 60_000;
			const PLAYERS_REFRESH_MS = 30 * 60_000;

			let activeTeams = new Set<string>(['all']);
			let pollTimer: ReturnType<typeof setTimeout> | null = null;
			let lastPlayersFetch = 0;

			function fmtTime(iso: string): string {
				try {
					return new Intl.DateTimeFormat('en-US', {
						timeZone: 'America/Chicago',
						weekday: 'short',
						month: 'short',
						day: 'numeric',
						hour: 'numeric',
						minute: '2-digit',
					}).format(new Date(iso));
				} catch {
					return iso;
				}
			}

			function esc(s: string): string {
				const div = document.createElement('div');
				div.textContent = s;
				return div.innerHTML;
			}

			// Games group by the calendar date they're played on on Ron's own
			// clock (Central), regardless of what timezone a viewer's browser
			// happens to be set to.
			function chicagoDateKey(iso: string): string {
				return new Intl.DateTimeFormat('en-CA', {
					timeZone: 'America/Chicago',
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
				}).format(new Date(iso));
			}

			function dateHeadingLabel(key: string, todayKey: string, tomorrowKey: string): string {
				const [y, m, d] = key.split('-').map(Number);
				const noonUTC = new Date(Date.UTC(y, m - 1, d, 12));
				const full = new Intl.DateTimeFormat('en-US', {
					timeZone: 'America/Chicago',
					weekday: 'long',
					month: 'long',
					day: 'numeric',
				}).format(noonUTC);
				if (key === todayKey) return `Today · ${full}`;
				if (key === tomorrowKey) return `Tomorrow · ${full}`;
				return full;
			}

			// Groups games by local date, preserving the order they arrived in
			// (callers pass already-sorted arrays), and renders one heading +
			// card grid per date.
			function renderDateGroups(games: GameInfo[], showScore: boolean): string {
				if (games.length === 0) return '';
				const todayKey = chicagoDateKey(new Date().toISOString());
				const tomorrowKey = chicagoDateKey(new Date(Date.now() + 86_400_000).toISOString());

				const order: string[] = [];
				const byDate = new Map<string, GameInfo[]>();
				for (const g of games) {
					const key = chicagoDateKey(g.startTimeUTC);
					if (!byDate.has(key)) {
						byDate.set(key, []);
						order.push(key);
					}
					byDate.get(key)!.push(g);
				}

				return order
					.map((key) => {
						const cards = byDate
							.get(key)!
							.map((g) => gameCardHtml(g, showScore))
							.join('');
						return `
							<div class="date-group">
								<h3 class="date-heading">${esc(dateHeadingLabel(key, todayKey, tomorrowKey))}</h3>
								<div class="cards-grid">${cards}</div>
							</div>
						`;
					})
					.join('');
			}

			function gameCardHtml(g: GameInfo, showScore: boolean): string {
				const vs = g.isHome ? 'vs' : '@';
				const meta: string[] = [fmtTime(g.startTimeUTC)];
				if (g.venue) meta.push(esc(g.venue));
				if (g.broadcast) meta.push(esc(g.broadcast));

				let scoreHtml = '';
				if (showScore && g.teamScore !== undefined && g.opponentScore !== undefined) {
					scoreHtml = `<div class="game-score">${g.teamScore}–${g.opponentScore}</div>`;
					if (g.status === 'final') scoreHtml += `<div class="status-final">Final</div>`;
				}

				const inner = `
					<span class="league-badge">${esc(g.league)}</span>
					${g.isNationalTV ? '<span class="national-badge">📺 National TV</span>' : ''}
					<div class="matchup">${esc(g.team)} ${vs} ${esc(g.opponent)}</div>
					<div class="game-meta">${meta.join(' · ')}</div>
					${scoreHtml}
				`;

				return g.link
					? `<a class="game-card" data-team="${esc(g.team)}" href="${esc(g.link)}" target="_blank" rel="noopener noreferrer">${inner}</a>`
					: `<div class="game-card" data-team="${esc(g.team)}">${inner}</div>`;
			}

			function liveCardHtml(g: GameInfo): string {
				const vs = g.isHome ? 'vs' : '@';
				const inner = `
					<div>
						<span class="live-label"><span class="live-dot"></span>Live</span>
						<div class="live-matchup">${esc(g.team)} ${vs} ${esc(g.opponent)}</div>
						<div class="live-detail">${esc(g.statusDetail ?? '')}${g.broadcast ? ' · ' + esc(g.broadcast) : ''}</div>
					</div>
					<div class="live-score">${g.teamScore ?? '–'}–${g.opponentScore ?? '–'}</div>
				`;
				return g.link
					? `<a class="live-banner" data-team="${esc(g.team)}" href="${esc(g.link)}" target="_blank" rel="noopener noreferrer">${inner}</a>`
					: `<div class="live-banner" data-team="${esc(g.team)}">${inner}</div>`;
			}

			function playerCardHtml(p: PlayerInfo): string {
				const chips = p.stats
					.map(
						(s) =>
							`<div class="stat-chip"><span class="stat-value">${esc(s.value)}</span><span class="stat-label">${esc(s.label)}</span></div>`
					)
					.join('');
				return `
					<div class="player-card" data-team="${esc(p.team)}">
						<div class="player-name">${esc(p.name)}</div>
						<div class="player-team">${esc(p.team)}${p.position ? ' · ' + esc(p.position) : ''}</div>
						<div class="player-stats">${chips || '<span class="game-meta">Stats unavailable right now</span>'}</div>
					</div>
				`;
			}

			function applyFilter() {
				const showAll = activeTeams.has('all') || activeTeams.size === 0;
				document.querySelectorAll<HTMLElement>('.game-card, .live-banner, .player-card').forEach((el) => {
					const team = el.dataset.team;
					const visible = showAll || (team ? activeTeams.has(team) : true);
					el.style.display = visible ? '' : 'none';
				});
				// A date group with every card filtered out shouldn't leave a
				// bare heading behind.
				document.querySelectorAll<HTMLElement>('.date-group').forEach((group) => {
					const anyVisible = Array.from(group.querySelectorAll<HTMLElement>('.game-card')).some(
						(card) => card.style.display !== 'none'
					);
					group.style.display = anyVisible ? '' : 'none';
				});
			}

			function renderScoreboard(data: Scoreboard) {
				const liveBlock = document.getElementById('live-block')!;
				const liveContainer = document.getElementById('live-container')!;
				if (data.hasLive) {
					liveBlock.style.display = 'block';
					liveContainer.innerHTML = data.live.map(liveCardHtml).join('');
				} else {
					liveBlock.style.display = 'none';
					liveContainer.innerHTML = '';
				}

				const upcomingContainer = document.getElementById('upcoming-container')!;
				upcomingContainer.innerHTML = data.upcoming.length
					? renderDateGroups(data.upcoming, false)
					: '<div class="empty-state">No upcoming games in the next few weeks.</div>';

				const recentContainer = document.getElementById('recent-container')!;
				recentContainer.innerHTML = data.recent.length
					? renderDateGroups(data.recent, true)
					: '<div class="empty-state">No recent results yet.</div>';

				applyFilter();
			}

			function renderPlayers(data: PlayersPayload) {
				const container = document.getElementById('players-container')!;
				container.innerHTML = data.players.length
					? data.players.map(playerCardHtml).join('')
					: '<div class="empty-state">Player stats unavailable right now.</div>';
				applyFilter();
			}

			function scheduleNextPoll(hasLive: boolean) {
				if (pollTimer) clearTimeout(pollTimer);
				pollTimer = setTimeout(pollScoreboard, hasLive ? LIVE_POLL_MS : IDLE_POLL_MS);
			}

			async function pollScoreboard() {
				try {
					const res = await fetch('/api/sports/scoreboard.json', { cache: 'no-store' });
					const data: Scoreboard = await res.json();
					renderScoreboard(data);
					scheduleNextPoll(data.hasLive);
				} catch {
					scheduleNextPoll(false);
				}
			}

			async function pollPlayers() {
				lastPlayersFetch = Date.now();
				try {
					const res = await fetch('/api/sports/players.json', { cache: 'no-store' });
					const data: PlayersPayload = await res.json();
					renderPlayers(data);
				} catch {
					// keep showing whatever we already have
				}
			}

			function initFilters() {
				const buttons = document.querySelectorAll<HTMLButtonElement>('#team-filters .filter-pill');
				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const team = btn.dataset.team!;
						if (team === 'all') {
							activeTeams = new Set(['all']);
						} else {
							activeTeams.delete('all');
							if (activeTeams.has(team)) activeTeams.delete(team);
							else activeTeams.add(team);
							if (activeTeams.size === 0) activeTeams = new Set(['all']);
						}
						buttons.forEach((b) => {
							const t = b.dataset.team!;
							b.classList.toggle('active', activeTeams.has('all') ? t === 'all' : activeTeams.has(t));
						});
						applyFilter();
					});
				});
			}

			function init() {
				const raw = document.getElementById('sports-initial-data')?.textContent;
				if (raw) {
					const initial = JSON.parse(raw) as { scoreboard: Scoreboard; players: PlayersPayload };
					renderScoreboard(initial.scoreboard);
					renderPlayers(initial.players);
					lastPlayersFetch = Date.now();
					scheduleNextPoll(initial.scoreboard.hasLive);
				} else {
					pollScoreboard();
					pollPlayers();
				}
				initFilters();

				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState !== 'visible') return;
					pollScoreboard();
					if (Date.now() - lastPlayersFetch > PLAYERS_REFRESH_MS) pollPlayers();
				});

				setInterval(() => {
					if (Date.now() - lastPlayersFetch > PLAYERS_REFRESH_MS) pollPlayers();
				}, 5 * 60_000);
			}

			init();
		</script>
	</body>
</html>
